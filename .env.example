# ============================
# AI-DocAgent 环境变量配置示例
# 复制此文件为 .env 并填入真实值
# ============================

# ----------------------------
# LLM API 通用配置
# ----------------------------
# 通义千问 (DashScope)
DASHSCOPE_API_KEY=your_dashscope_api_key_here
DASHSCOPE_API_BASE=https://dashscope.aliyuncs.com/api/v1

# 智谱AI (ChatGLM)
ZHIPU_API_KEY=your_zhipu_api_key_here
ZHIPU_API_BASE=https://open.bigmodel.cn/api/paas/v4

# OpenAI 兼容接口
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_API_BASE=https://api.openai.com/v1

# 默认使用的大模型提供商 (qwen / zhipu / openai)
DEFAULT_LLM_PROVIDER=qwen

# ----------------------------
# MySQL 数据库配置
# ----------------------------
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=ai_docagent

# ----------------------------
# MongoDB 数据库配置
# ----------------------------
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_USER=admin
MONGO_PASSWORD=your_mongo_password
MONGO_DATABASE=ai_docagent
MONGO_COLLECTION=raw_documents

# ----------------------------
# Redis 配置
# ----------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password
REDIS_DB=0

# ----------------------------
# 任务调度配置
# ----------------------------
# 单批最大处理文档数
MAX_BATCH_SIZE=100
# API请求最大重试次数
MAX_RETRY_COUNT=3
# 请求重试间隔（秒）
RETRY_INTERVAL=5
# 任务状态文件路径
TASK_STATUS_FILE=status/task_runtime_status.json

# ----------------------------
# 日志配置
# ----------------------------
LOG_LEVEL=INFO
LOG_DIR=logs/
